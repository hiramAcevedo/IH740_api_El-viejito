# Copia este archivo como .env y llena las llaves del sandbox de Stripe (pk_test_... y sk_test_...).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
DATABASE_URL=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGENES=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# A dónde regresa el comprador desde Stripe: el sitio (en local, Vite)
SITIO_URL=http://localhost:5173
# El secreto con que Stripe firma sus avisos (en local, lo da `stripe listen --print-secret`)
STRIPE_WEBHOOK_SECRET=
# La llave de servicio de Supabase: crea y borra cuentas del panel. Nunca va al sitio.
SUPABASE_SERVICE_KEY=
